# Keep the build context — and therefore the image — to the code the service
# actually runs. `COPY . .` copies everything left after these exclusions.
.git
.gitignore
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local virtualenvs — never belong in the image
venv/
.venv/
env/
ENV/

# local scratch that can sit in a working copy
*.log
*.zip
*.tar.gz
.DS_Store
.idea/
.vscode/

# Not code the service runs: notes, validation fixtures, stray diffs (they
# describe removed endpoints and internals; 2026-11 audit L3). scripts/ stays:
# check_startup.py is written to run inside the image.
maindiff.txt
eline*
docs/
validation/
*.md
